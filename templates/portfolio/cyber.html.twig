{% extends 'base.html.twig' %}

{% block title %}Mon Eportfolio{% endblock %}

{% block body %}

<div class="title-container">
    <h1 class="mt-4"><br>Les ressources et SAE intéressantes en S3 Cybersécurité</h1>
</div>
<br><br><br>
    <div class="container">
        <section class="header">
            <div class="header-content">
                <h1>SAE 3.01 Développer des applications communicantes</h1>
            </div>

        </section>

        <section class="header">
            <div class="header-content">
                <h1>SAE 3.03 Concevoir un réseau informatique sécurisé multi-sites</h1>
            </div>

        </section>

        <section class="header">
            <div class="header-content">
                <h1>SAE 3.04 Découvrir le pentesting</h1>
            </div>

        </section>

        <section class="header">
            <div class="header-content">
                <h1>R3.16 Méthodologie du pentesting</h1>
            </div>

        </section>
    </div>

    <div class="footer">
        <p>&copy; 2025 Tavernier Noa - Tous droits réservés.</p>
        <p>Mentions Légales</p>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    <style>
        body, html {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
        }
        .container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(3, auto);
            gap: 40px;
            width: 95%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .title-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100px;
            margin-top: 20px;
            margin-bottom: 120px;
        }

        h1.mt-4 {
            text-align: center;
            color: white;
            font-size: 5vw;
            

        }

        h1{
            color: rgba(5, 43, 124, 0.8);
            
        }

        p{
            color: rgba(30, 85, 204, 0.8);
            
        }

        .footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px;
            width: 100%;
        }

        .footer a {
            color: #fff;
            text-decoration: none;
        }

        .footer p {
            color: white;
            text-decoration: none;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        .header {
            background-color: rgba(255, 255, 255, 0.8);
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
            width: 90%;
            margin: 0 auto;
            height: 300px;
            text-align: center;
        }
        .header-content h1 {
            font-size: 2.5em;
        }

        .header-image {
            max-width: 150px;
            border-radius: 8px;
        }

        section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background-color: rgba(255, 255, 255, 0.7);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.2);
            height: 300px;
            max-width: 100%;
            width: 90%;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        section:hover {
            transform: scale(1.05);
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.3);
        }
        .btn-custom {
            background-color:rgb(230, 128, 12);
            color: white;
            padding: 10px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            text-decoration: none;
            margin-top: 20px;
        }

        .btn-custom:hover {
            background-color:rgb(197, 108, 7);
            cursor: pointer;
        }

    </style>
{% endblock %}
